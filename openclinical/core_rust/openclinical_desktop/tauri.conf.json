{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClinical",
  "version": "0.1.0",
  "identifier": "org.openclinical.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend_ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClinical - Point-of-Care SUS/ANVISA",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "openclinical_core.sqlite"
    ]
  }
}
